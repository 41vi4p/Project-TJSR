{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/firebase/layout,_N_T_/dashboard/firebase/page,_N_T_/dashboard/firebase"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/firebase/__PAGE__",
    "/dashboard/firebase",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}