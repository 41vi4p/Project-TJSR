{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/debug/layout,_N_T_/dashboard/debug/page,_N_T_/dashboard/debug"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/debug/__PAGE__",
    "/dashboard/debug",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}